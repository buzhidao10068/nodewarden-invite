# Required for the application page. Never commit real values.
HASH_SALT="REPLACE_WITH_32_BYTE_OR_LONGER_RANDOM_SECRET"
ADMIN_TOKEN="REPLACE_WITH_32_BYTE_OR_LONGER_ADMIN_TOKEN"
# 可选网页 2FA：生成独立 Base32 密钥后取消注释并替换；不要使用示例值。
# ADMIN_TOTP_SECRET="REPLACE_WITH_RANDOM_BASE32_SECRET"
# 可选：web 仅启用网页、api 仅启用 PowerShell/API、both 同时启用（默认 both）。
ADMIN_ACCESS_MODE="both"
TURNSTILE_SECRET="REPLACE_WITH_TURNSTILE_SECRET"
TURNSTILE_SITE_KEY="REPLACE_WITH_TURNSTILE_SITE_KEY"
# Optional: link a manually emailed invite, inspect/revoke it or ban its usedBy.
NODEWARDEN_URL="https://vault.example.com"
NODEWARDEN_CLIENT_ID="user.REPLACE_WITH_ADMIN_USER_ID"
NODEWARDEN_CLIENT_SECRET="REPLACE_WITH_NODEWARDEN_API_KEY"
NODEWARDEN_MASTER_PASSWORD_HASH="REPLACE_WITH_NODEWARDEN_MASTER_PASSWORD_HASH"
DATA_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
# Local Turnstile bypass requires BOTH TURNSTILE_* values above to be "".
ALLOW_INSECURE_LOCAL_DEV="true"
