{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodewarden-invite",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nodewarden-invite",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }],
  "vars": { "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY", "ADMIN_ACCESS_MODE": "both" },
  "triggers": { "crons": [] },
  "keep_vars": true
}
